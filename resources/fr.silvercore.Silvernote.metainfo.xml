<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>fr.silvercore.Silvernote</id>
  
  <name>Silvernote</name>
  <summary>Application de prise de notes simple et intuitive</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer_name>Silvercore</developer_name>

  <description>
    <p>
      Silvernote est une application de prise de notes moderne, rapide et sécurisée. Organisez vos idées, dossiers et tags, sur tous vos appareils.
    </p>
    <p>Fonctionnalités principales :</p>
    <ul>
      <li>Interface épurée et distraction-free</li>
      <li>Organisation par dossiers et étiquettes</li>
      <li>Synchronisation rapide</li>
    </ul>
  </description>

  <launchable type="desktop-id">fr.silvercore.Silvernote.desktop</launchable>

