{
  "name": "Silvernote",
  "productName": "Silvernote",
  "version": "1.1.16",
  "description": "Silvernote est une application de prise de notes moderne, rapide et sécurisée. Organisez vos idées, dossiers et tags, sur tous vos appareils.",
  "dev": false,
  "main": "src/app.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SilverCore-Git/silvernote_app.git"
  },
  "scripts": {
    "start": " electron-forge start",
    "dev": "electron-forge start",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "maj:front": "node scripts/maj_front",
    "icon": "npx electron-icon-maker --input=resources/icon.png --output=resources",
    "build:flathub": "npm i && npm run build:linux && mkdir build-dir && npm run flathub",
    "flathub:build": "flatpak-builder --force-clean build-dir fr.silvercore.Silvernote.yml",
    "flathub:start": "flatpak-builder --run build-dir fr.silvercore.Silvernote.yml silvernote",
    "flathub": "rm -rf build-dir .flatpak-builder && npm run flathub:build && npm run flathub:start"
  },
  "keywords": [],
  "author": {
    "name": "Silvercore Inc.",
    "url": "https://www.silvercore.fr"
  },
  "license": "Proprietary",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.4.1",
    "unzipper": "^0.12.3",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/core": "^7.8.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10"
  },
  "build": {
    "appId": "fr.silvercore.Silvernote",
    "productName": "Silvernote",
    "directories": {
      "output": "build",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "resources/icons/win/icon.ico",
      "uninstallerIcon": "resources/icons/win/icon.ico",
      "installerHeaderIcon": "resources/icons/win/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "icon": "resources/icons/png",
      "maintainer": "silvercore",
      "description": "Application de prise de note simple et intuitive."
    }
  }
}
